PORT=8080
# Your Netlify site URL, for CORS and the WebSocket origin check
ALLOWED_ORIGIN=https://your-site.netlify.app
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Folder on a persistent disk. Encrypt the volume: it holds WhatsApp sessions.
DATA_DIR=./data
# How long a saved WhatsApp link keeps listening after the last tab closes, in ms (default 12h).
# This is what lets the phone notify about new messages while the app is shut.
WA_IDLE_MS=43200000
# Contact address sent to push services (must be a mailto: or https: URL).
VAPID_SUBJECT=mailto:you@example.com
# Razorpay (UPI, cards, netbanking). Dashboard > Account & Settings > API keys.
# Without these the billing layer runs in test mode: orders are simulated, no money moves.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret from Razorpay > Settings > Webhooks (events: payment.captured, payment.failed).
RAZORPAY_WEBHOOK_SECRET=
# Add the two Razorpay keys above to switch billing to live checkout. Set this to 1 only to
# keep simulated payments while keys are present (staging), never in production.
BILLING_TEST=
# Shared secret for the RevenueCat (native IAP) webhook. Must match the Authorization
# header configured in RevenueCat → Integrations → Webhooks.
REVENUECAT_WEBHOOK_AUTH=
# RevenueCat public SDK keys (client-side). In a Vite project put these in .env as
# VITE_REVENUECAT_ANDROID_KEY / VITE_REVENUECAT_IOS_KEY; in this vanilla app paste them
# into config.js (window.SOULSYNC_CONFIG.revenueCat).
VITE_REVENUECAT_ANDROID_KEY=
VITE_REVENUECAT_IOS_KEY=
