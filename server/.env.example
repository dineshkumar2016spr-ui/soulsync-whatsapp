PORT=8080
# Your Netlify site URL, for CORS and the WebSocket origin check
ALLOWED_ORIGIN=https://your-site.netlify.app
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Folder on a persistent disk. Encrypt the volume: it holds WhatsApp sessions.
DATA_DIR=./data

# Optional TURN relay for calls on strict NATs or mobile networks (comma-separated URLs).
# Without it, calls use public STUN and may fail when both sides are behind symmetric NATs.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ── Verified model check (2026-11-05): gemini-2.0-flash & gpt-4o-mini still current.
# Update if you rely on newer flagships (e.g. gemini-2.5-flash) after checking the provider's docs.
